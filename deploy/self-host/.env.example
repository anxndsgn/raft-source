# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# Public URLs. The web app and the API are on two hostnames.
APP_URL=https://raft.example.com
SERVER_URL=https://api.example.com
# Hostnames for the optional Caddy HTTPS front door (--profile caddy).
APP_HOST=raft.example.com
API_HOST=api.example.com

JWT_SECRET=
POSTGRES_PASSWORD=

# Email. Without a Resend key, emails (verification codes, invites, password
# resets) are printed to the server log: docker compose logs server | grep -A20 "DEV EMAIL"
RESEND_API_KEY=
FROM_EMAIL=

# Attachments go to the local `uploads` volume unless all four S3_* are set.
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ATTACHMENTS_BUCKET=

# External Postgres instead of the bundled one (needs wal_level=logical, and a
# database named `slock`). Leave empty for the bundled container.
# DATABASE_URL=postgresql://user:pass@host:5432/slock
# CDC_HOST=host
# CDC_PORT=5432
# CDC_USERNAME=user
# CDC_PASSWORD=pass

# Memory (defaults suit a 4 GB machine).
# RISINGWAVE_MEMORY_BYTES=2147483648
# RISINGWAVE_MEM_LIMIT=2560m
# SERVER_HEAP_MB=512
# SERVER_MEM_LIMIT=1g

# Local-only binds by default; Caddy reaches them over the compose network.
# SERVER_BIND=127.0.0.1:3001
# WEB_BIND=127.0.0.1:8080

# Optional: Artifacts (workspace pages). Needs an app-content bucket and the
# content Worker (packages/content-worker) on a separate registrable domain;
# see packages/content-worker/README.md. Leave empty to keep Artifacts off.
# The web image also needs the repository variable ARTIFACTS_CONTENT_DOMAIN.
APP_STORAGE_R2_ENDPOINT=
APP_STORAGE_R2_REGION=auto
APP_STORAGE_R2_ACCESS_KEY_ID=
APP_STORAGE_R2_SECRET_ACCESS_KEY=
APP_STORAGE_R2_BUCKET=
ARTIFACTS_CONTENT_DOMAIN=
ARTIFACTS_CONTENT_WORKER_TOKEN=
ARTIFACTS_CONTENT_RAFT_TOKENS=

# Custom MCP apps: key that encrypts saved connection headers (API keys).
# Required to save a connection with headers. Generate once, never change:
#   openssl rand -base64 32
SLOCK_MCP_CREDENTIAL_KEY=
