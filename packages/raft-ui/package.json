{
  "name": "@botiverse/raft-ui",
  "version": "0.102.11",
  "description": "React components and CSS foundations for the Raft Design System.",
  "keywords": [
    "agent-skills",
    "base-ui",
    "components",
    "design-system",
    "react",
    "tailwindcss",
    "tanstack-intent"
  ],
  "homepage": "https://raft-design.botiverse.build",
  "bugs": "https://github.com/botiverse/raft-design/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/botiverse/raft-design.git",
    "directory": "packages/ui"
  },
  "files": [
    "CHANGELOG.md",
    "checks",
    "codemods",
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.mjs",
    "./dist/wip.mjs",
    "./dist/lib/drag-escape.mjs",
    "./src/lib/drag-escape.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cn": {
      "types": "./dist/cn.d.mts",
      "default": "./dist/cn.mjs"
    },
    "./wip": {
      "types": "./dist/wip.d.mts",
      "default": "./dist/wip.mjs"
    },
    "./lint": {
      "types": "./dist/lint.d.mts",
      "default": "./dist/lint.mjs"
    },
    "./lint/recommended.json": "./dist/lint/recommended.json",
    "./fonts.css": "./dist/fonts.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./foundation.css": "./dist/foundation.css",
    "./tokens.json": "./dist/tokens.json",
    "./themes.css": "./dist/themes.css"
  },
  "scripts": {
    "bench:virtual-list": "node bench/virtual-list/run.mjs",
    "build:themes": "node scripts/build-themes.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "test": "vp test",
    "typecheck:tsrs": "tsrs --noEmit",
    "prepare": "vp pack"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@botiverse/lint": "^0.1.0",
    "@botiverse/ricons": "^0.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-hotkeys": "^0.23.1",
    "cnfast": "^0.2.0",
    "foxact": "^0.3.12",
    "lucide-react": "^1.72.0",
    "react-resizable-panels": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@babel/parser": "^7.29.9 || ^8.0.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@babel/parser": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true
}
